<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001-create-schema" author="digi-carts" runAlways="true">
        <validCheckSum>ANY</validCheckSum>
        <sql>CREATE SCHEMA IF NOT EXISTS payment_svc</sql>
    </changeSet>

    <changeSet id="002-create-platform-payment-config" author="digi-carts">
        <createTable tableName="platform_payment_config" schemaName="payment_svc">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="razorpay_key_id" type="VARCHAR(255)"/>
            <column name="razorpay_key_secret" type="VARCHAR(255)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="route_enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="default_platform_fee_percent" type="DOUBLE PRECISION" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="webhook_secret" type="VARCHAR(255)"/>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-create-store-payment-config" author="digi-carts">
        <createTable tableName="store_payment_config" schemaName="payment_svc">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="store_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="razorpay_key_id" type="VARCHAR(255)"/>
            <column name="razorpay_key_secret" type="VARCHAR(255)"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="online_mode" type="VARCHAR(50)" defaultValue="OWN">
                <constraints nullable="false"/>
            </column>
            <column name="route_account_id" type="VARCHAR(255)"/>
            <column name="kyc_status" type="VARCHAR(50)" defaultValue="NOT_STARTED">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="store_payment_config" schemaName="payment_svc" indexName="idx_store_payment_config_store_id">
            <column name="store_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="004-create-payment-order" author="digi-carts">
        <createTable tableName="payment_order" schemaName="payment_svc">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="razorpay_order_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="amount" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="VARCHAR(10)" defaultValue="INR">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="reference_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="store_id" type="VARCHAR(255)"/>
            <column name="user_id" type="VARCHAR(255)"/>
            <column name="status" type="VARCHAR(50)" defaultValue="CREATED">
                <constraints nullable="false"/>
            </column>
            <column name="razorpay_payment_id" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="payment_order" schemaName="payment_svc" indexName="idx_payment_order_store_id">
            <column name="store_id"/>
        </createIndex>
        <createIndex tableName="payment_order" schemaName="payment_svc" indexName="idx_payment_order_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="payment_order" schemaName="payment_svc" indexName="idx_payment_order_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="005-create-processed-webhook" author="digi-carts">
        <createTable tableName="processed_webhook" schemaName="payment_svc">
            <column name="id" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(255)"/>
            <column name="received_at" type="TIMESTAMPTZ" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="006-seed-global-platform-payment-config" author="digi-carts">
        <insert tableName="platform_payment_config" schemaName="payment_svc">
            <column name="id" value="global"/>
            <column name="enabled" valueBoolean="false"/>
            <column name="route_enabled" valueBoolean="false"/>
            <column name="default_platform_fee_percent" valueNumeric="0"/>
        </insert>
    </changeSet>

</databaseChangeLog>
